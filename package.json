{
  "name": "app",
  "private": true,
  "dependencies": {
    "@babel/core": "7",
    "@babel/plugin-transform-runtime": "7",
    "@babel/preset-env": "^7.28.3",
    "@babel/runtime": "7",
    "@rails/activestorage": "^8.0.200",
    "@rails/ujs": "^7.1.3-4",
    "@types/babel__core": "7",
    "@types/webpack": "5",
    "babel-loader": "8",
    "compression-webpack-plugin": "9",
    "shakapacker": "7.2.3",
    "terser-webpack-plugin": "5",
    "turbolinks": "^5.2.0",
    "webpack": "5",
    "webpack-assets-manifest": "5",
    "webpack-cli": "4",
    "webpack-merge": "5"
  },
  "version": "0.1.0",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "babel": {
    "presets": [
      "./node_modules/shakapacker/package/babel/preset.js",
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ],
      "@babel/preset-typescript"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/app/javascript/$1"
    },
    "testMatch": [
      "<rootDir>/test/javascript/**/*.test.js",
      "<rootDir>/app/javascript/**/*.test.js"
    ]
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "ts-jest": "^29.4.1",
    "webpack-dev-server": "4"
  }
}
